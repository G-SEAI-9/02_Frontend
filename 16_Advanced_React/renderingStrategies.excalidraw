    {
      "id": "ssr-con",
      "type": "text",
      "x": 1100,
      "y": 1890,
      "width": 686,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "i0051",
      "roundness": null,
      "seed": 1051,
      "version": 1,
      "versionNonce": 2051,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761480000000,
      "link": null,
      "locked": false,
      "text": "Nachteile\n- Server rendert bei jedem Request:\n  mehr Last, längere Wartezeit aufs html\n- klassisch: jeder Klick lädt die ganze Seite neu\n- Next.js: sichtbar, aber erst interaktiv,\n  wenn das JS geladen ist (Hydration)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nachteile\n- Server rendert bei jedem Request:\n  mehr Last, längere Wartezeit aufs html\n- klassisch: jeder Klick lädt die ganze Seite neu\n- Next.js: sichtbar, aber erst interaktiv,\n  wenn das JS geladen ist (Hydration)",
      "autoResize": true,
      "lineHeight": 1.25
    },
