      "versionNonce": 2028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761480000000,
      "link": null,
      "locked": false,
      "text": "Vorteile\n+ viel Userinteraktivität\n+ schnelle Seitenwechsel ohne Reload\n+ einfaches Hosting: nur statische Dateien",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vorteile\n+ viel Userinteraktivität\n+ schnelle Seitenwechsel ohne Reload\n+ einfaches Hosting: nur statische Dateien",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "csr-con",
      "type": "text",
      "x": 1100,
      "y": 740,
      "width": 613.79052734375,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
