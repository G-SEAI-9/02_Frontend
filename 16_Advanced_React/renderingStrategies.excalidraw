      "text": "Vorteile\n+ Inhalt sofort sichtbar (fertiges html)\n+ gut für SEO\n+ Daten bei jedem Request aktuell",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
